void preEntryInBall(bool &wasSpacePressed,
                    bool &inGame,
                    Cannon &cannon,
                    float &lastBall,
                    float ballDelta,
                    vector<Ball> &balls,
                    int valueBalls,
                    const int sideCannon,
                    const int thickBoundaryLine,
                    vector<Bric> &brics
                    ){
    if (IsKeyPressed(KEY_SPACE) || wasSpacePressed) {                       //Если нажат ПРОБЕЛ
        inGame = true;
        cannon.isShooting = true;

        Ball b(cannon.screenWidth, thickBoundaryLine, sideCannon);
        Vector2 cannonAngle;
        cannonAngle.x = -cos(cannon.cannonAngle / 180 * PI - PI / 2) * 3;
        cannonAngle.y = -sin(cannon.cannonAngle / 180 * PI - PI / 2) * 3;
        if (GetTime() - lastBall > ballDelta &&
            balls.size() < valueBalls) {    //Когда наступает время ballDelta и кол-во мячей меньше чем нужное кол-во
            //Создаем вспомогательный мяч
            b.BallSpeed = {cannonAngle.x, cannonAngle.y};
            b.BallPosition.x = cannon.cannonPositionX + sideCannon /
                                                        4;                                 //Точка появление мяча по оси x = середине пушки по X
            b.BallPosition.y = cannon.cannonPositionY - thickBoundaryLine * 2 +
                               5;                          //Точка появление мяча по оси y = высоте пушки
            balls.push_back(b);                                   //Кладем в конец вектора мячей вспомогательный мяч
            lastBall = GetTime();
            wasSpacePressed = true;
        }
    }

}
void checkAndDraw(bool &wasSpacePressed,
                  Cannon &cannon,
                  float &lastBall,
                  vector<Ball> &balls,
                  const int thickBoundaryLine,
                  int valueBrics,
                  vector<Bric> brics,
                  bool &inGame) {

//////////////////////////////////////////////////////
    if (inGame) {
        for (int i = 0; i < balls.size(); ++i) {    ///Берем все выпущенные мячи
//////////////////////////////////////////////////////Смотрим за каждым выпущенным мячом на наличие выхода за ограничительную линию и расчитываем рисовать его или нет
            if (balls[i].isOutOfBounds) {           ///Если мяч за пределами
                balls[i].isOutOfBounds = false;
                balls[i].BallSpeed = {0, 0};

            }
/////////////////////////////////////////////////////Проверяем на столкновение с каждым кирпичом

/////////////////////////////////////////////////////Отрисовываем выпущенные мячи

            if (balls[i].BallPosition.y + balls[i].ballRadius >= 800 - thickBoundaryLine - cannon.sideCannon) {    ///Если мяч выходит за белую черту,
                balls[i].isOutOfBounds = true;                                                              ///то отмечаем это
            }
            if (!(balls[i].isOutOfBounds)) {
                for (int j = 0; j < valueBrics; ++j) {
                    balls[i].checkCollisionBall(balls[i].BallPosition, balls[i].ballRadius,
                                                {brics[j].bricPosition.x, brics[j].bricPosition.y}, brics[j].widthBric,
                                                brics[j].heightBric);
//                cout<<balls[i].BallPosition.x<<"  "<<balls[i].BallPosition.x<<"//////////"<< brics[0].bricPosition.x<< brics[0].bricPosition.y<<endl;
                }
                balls[i].drawBall();                //Рисуем мяч
            }
        }
    }
}


